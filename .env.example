# =====================================================================
# BABYMETAL ARGENTINA — environment variables (TEMPLATE)
# =====================================================================
# Copy this file to `.env.local` and fill in values locally.
#   cp .env.example .env.local
# `.env.local` and any other `.env*` file are git-ignored. Never commit them.
#
# ---------------------------------------------------------------------
# PUBLIC (browser) variables
# ---------------------------------------------------------------------
# Only variables prefixed with VITE_PUBLIC_ are exposed to the browser
# (see `envPrefix` in vite.config.ts). Anything with this prefix ends up
# inside the built JavaScript and is readable by ANY visitor.
# => Put only values that are safe to be public here.

# Canonical URL of the deployed site (used for share links / meta tags).
VITE_PUBLIC_SITE_URL=

# Future: Supabase project URL and anon (publishable) key.
# The anon key is public by design and only safe with Row Level Security
# enabled on every table. Leave empty until Supabase is introduced.
VITE_PUBLIC_SUPABASE_URL=
VITE_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------
# SERVER-ONLY secrets (NEVER prefix with VITE_PUBLIC_)
# ---------------------------------------------------------------------
# These must only live in a protected environment (Supabase Edge Function
# secrets, hosting provider env settings, CI secrets) — never in the
# frontend bundle and never in this repository.
#
# SUPABASE_SERVICE_ROLE_KEY=
